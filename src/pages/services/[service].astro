---
import BaseLayout from "../../components/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { SITE_URL, PHONE_DISPLAY, telLink, SERVICE_AREA } from "../../config";
import { serviceSchema, faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../lib/schema";
import servicesData from "../../data/services.json";
import citiesData from "../../data/cities.json";

export async function getStaticPaths() {
  return servicesData.services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const canonical = `${SITE_URL}/services/${s.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/#services" },
  { name: s.name, url: `/services/${s.slug}/` },
];
const others = servicesData.services.filter((x) => x.slug !== s.slug);
const schemaHtml = jsonLd(
  serviceSchema({ name: s.name, description: s.metaDescription, url: `/services/${s.slug}/` }),
  localBusinessSchema({ url: `/services/${s.slug}/`, areaServed: citiesData.cities.map((c) => c.name) }),
  faqSchema(s.faqs),
  breadcrumbSchema(crumbs)
);
---
<BaseLayout title={s.title} description={s.metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage={`/images/service-${s.slug}.jpg`}>
  <section class="relative overflow-hidden bg-cream-50">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-28 -right-28 h-96 w-96 rounded-full bg-pine-100 blur-3xl"></div>
      <div class="absolute top-48 -left-28 h-80 w-80 rounded-full bg-gold-300 opacity-30 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-14 pt-8 lg:pb-20 lg:pt-12">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.05fr_0.9fr] lg:gap-14">
        <div>
          <div class="inline-flex items-center gap-2.5 rounded-full border border-pine-200 bg-white px-4 py-2 text-sm font-semibold text-pine-800 shadow-sm">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-pine-50 text-pine-800" aria-hidden="true">
              <ServiceIcon slug={s.slug} />
            </span>
            <span>{s.name} · {SERVICE_AREA}</span>
          </div>
          <h1 class="mt-5 font-display text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">{s.h1}</h1>
          <div class="mt-6 space-y-4">
            {s.intro.map((p) => <p class="text-lg leading-relaxed text-ink-600">{p}</p>)}
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={telLink} class="btn-pine inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Call {PHONE_DISPLAY}
            </a>
            <a href="#quote" class="btn-gold inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine-700 focus-visible:ring-offset-2">
              Get a Free Quote
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-ink-600">
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Licensed local technicians
            </li>
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Same-day availability
            </li>
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Satisfaction guarantee
            </li>
          </ul>
        </div>
        <div class="space-y-6 lg:sticky lg:top-6">
          <figure class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-2xl">
            <img src={`/images/service-${s.slug}.jpg`} alt={`${s.name} — Orlando Pest Pros`} width="1920" height="1280" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="flex items-center justify-between gap-4 border-t border-slate-200 bg-white px-6 py-4 text-sm">
              <span class="flex items-center gap-2 font-bold text-ink-900">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 1114 0c0 5.5-7 11-7 11z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
                Orlando Pest Pros
              </span>
              <span class="font-medium text-ink-600">Central Florida homes</span>
            </figcaption>
          </figure>
          <aside class="rounded-3xl bg-pine-950 p-6 shadow-xl sm:p-8" aria-labelledby="pests-heading">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gold-400 text-pine-950" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              </span>
              <h2 id="pests-heading" class="font-display text-xl tracking-tight text-white">Pests we handle</h2>
            </div>
            <ul class="mt-6 space-y-4">
              {s.pests.map((p) => (
                <li class="border-t border-white/10 pt-4 first:border-0 first:pt-0">
                  <p class="font-semibold text-white">{p.name}</p>
                  <p class="mt-1 text-sm leading-relaxed text-white/70">{p.blurb}</p>
                </li>
              ))}
            </ul>
            <a href="#quote" class="mt-7 inline-flex min-h-[48px] w-full items-center justify-center rounded-full border border-white/20 px-6 py-3 text-sm font-bold text-white motion-safe:transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">Check availability in your area</a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  {s.sections.map((sec, idx) => (
    <section class={idx % 2 === 0 ? "reveal bg-white py-20 lg:py-24" : "reveal border-y border-slate-200 bg-cream-50 py-20 lg:py-24"} aria-labelledby={`service-section-${idx}`}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Orlando Pest Pros</p>
          <h2 id={`service-section-${idx}`} class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{sec.heading}</h2>
          <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
        </div>
        <div class="mt-6 max-w-3xl space-y-4">
          {sec.body.map((p) => <p class="leading-relaxed text-ink-600">{p}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section aria-labelledby="process-heading" class="reveal relative overflow-hidden bg-pine-950 py-20 lg:py-24">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 right-0 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-gold-400 opacity-10 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Simple and transparent</p>
        <h2 id="process-heading" class="mt-3 font-display text-3xl tracking-tight text-white sm:text-4xl">How it works</h2>
        <p class="mt-4 leading-relaxed text-white/70">From first call to final walkthrough, everything is handled by a licensed local professional.</p>
      </div>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {s.process.map((st, i) => (
          <li class="rounded-3xl border border-white/10 bg-white/5 p-6 motion-safe:transition hover:bg-white/10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gold-400 font-display text-lg font-bold text-pine-950" aria-hidden="true">{i + 1}</span>
            <p class="mt-4 font-bold text-white">{st.step}</p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{st.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="areas-heading" class="reveal bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Service area</p>
          <h2 id="areas-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{s.name} across {SERVICE_AREA}</h2>
          <p class="mt-4 leading-relaxed text-ink-600">We bring {s.name.toLowerCase()} to homes and businesses throughout both counties:</p>
        </div>
        <a href={telLink} class="inline-flex min-h-[48px] shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-pine-800 shadow-sm motion-safe:transition hover:border-pine-600 hover:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">Call {PHONE_DISPLAY}</a>
      </div>
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {citiesData.cities.map((c) => (
          <li>
            <a href={`/locations/${c.slug}/${s.slug}/`} class="group flex min-h-[48px] items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-cream-50 px-5 py-4 font-semibold text-ink-900 motion-safe:transition hover:border-pine-600 hover:bg-white hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
              <span>{s.name} in {c.name}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-gold-600 motion-safe:transition motion-safe:group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="related-heading" class="reveal border-t border-slate-200 bg-cream-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Keep exploring</p>
        <h2 id="related-heading" class="mt-3 font-display text-2xl tracking-tight text-ink-900 sm:text-3xl">Related services</h2>
      </div>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((o) => (
          <a href={`/services/${o.slug}/`} class="group flex min-h-[48px] items-center gap-4 rounded-3xl border border-slate-200 bg-white p-5 motion-safe:transition hover:border-pine-600 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-pine-50 text-pine-800" aria-hidden="true">
              <ServiceIcon slug={o.slug} />
            </span>
            <span>
              <span class="block font-bold text-ink-900 group-hover:text-pine-800">{o.name}</span>
              <span class="mt-1 flex items-center gap-1.5 text-sm font-medium text-ink-600">Explore service <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-white">
    <div class="mx-auto max-w-7xl space-y-16 px-4 py-20 sm:px-6 lg:space-y-20 lg:px-8 lg:py-24">
      <FaqAccordion faqs={s.faqs} heading={`${s.name} FAQs`} id="faq" />
      <QuoteForm preselectService={s.slug} heading={`Get a free ${s.name.toLowerCase()} quote`} />
      <CtaBand heading="Pests don't wait. Neither should you." text={`One call and a licensed local technician is on the way. Same-day service available across ${SERVICE_AREA}.`} />
    </div>
  </div>
</BaseLayout>
