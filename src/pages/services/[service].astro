---
import BaseLayout from "../../components/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { SITE_URL, PHONE_DISPLAY, telLink, SERVICE_AREA } from "../../config";
import { serviceSchema, faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../lib/schema";
import servicesData from "../../data/services.json";
import citiesData from "../../data/cities.json";

export async function getStaticPaths() {
  return servicesData.services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const canonical = `${SITE_URL}/services/${s.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/#services" },
  { name: s.name, url: `/services/${s.slug}/` },
];
const others = servicesData.services.filter((x) => x.slug !== s.slug);
const schemaHtml = jsonLd(
  serviceSchema({ name: s.name, description: s.metaDescription, url: `/services/${s.slug}/` }),
  localBusinessSchema({ url: `/services/${s.slug}/`, areaServed: citiesData.cities.map((c) => c.name) }),
  faqSchema(s.faqs),
  breadcrumbSchema(crumbs)
);
---
<BaseLayout title={s.title} description={s.metaDescription} canonical={canonical} schemaHtml={schemaHtml}>
  <div class="bg-brand-50/60 border-b border-brand-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_360px] items-start">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-white border border-brand-200 px-4 py-1.5 text-sm font-semibold text-brand-800">
            <ServiceIcon slug={s.slug} />
            {s.name} · {SERVICE_AREA}
          </div>
          <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold text-slate-900 leading-tight">{s.h1}</h1>
          {s.intro.map((p) => <p class="mt-4 text-lg text-slate-600 leading-relaxed">{p}</p>)}
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={telLink} class="inline-flex justify-center items-center gap-2 rounded-full bg-brand-700 px-7 py-3.5 font-extrabold text-white hover:bg-brand-800">Call {PHONE_DISPLAY}</a>
            <a href="#quote" class="inline-flex justify-center items-center gap-2 rounded-full bg-accent-500 px-7 py-3.5 font-extrabold text-slate-900 hover:bg-accent-600">Get a Free Quote</a>
          </div>
        </div>
        <aside class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
          <h2 class="font-extrabold text-slate-900">Pests we handle</h2>
          <ul class="mt-3 space-y-3">
            {s.pests.map((p) => (
              <li>
                <p class="font-semibold text-sm text-slate-900">{p.name}</p>
                <p class="text-sm text-slate-600">{p.blurb}</p>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 space-y-14">
    {s.sections.map((sec) => (
      <section>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{sec.heading}</h2>
        {sec.body.map((p) => <p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">{p}</p>)}
      </section>
    ))}

    <section aria-labelledby="process-heading">
      <h2 id="process-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900">How it works</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {s.process.map((st, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-5">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-700 font-extrabold text-white">{i + 1}</span>
            <p class="mt-3 font-bold text-slate-900">{st.step}</p>
            <p class="mt-1 text-sm text-slate-600">{st.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="areas-heading">
      <h2 id="areas-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900">{s.name} across {SERVICE_AREA}</h2>
      <p class="mt-3 text-slate-600 max-w-3xl">We bring {s.name.toLowerCase()} to homes and businesses throughout both counties:</p>
      <ul class="mt-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {citiesData.cities.map((c) => (
          <li><a href={`/locations/${c.slug}/${s.slug}/`} class="block rounded-xl border border-slate-200 bg-white px-4 py-3 font-semibold text-brand-800 hover:border-brand-600 hover:shadow-sm">{s.name} in {c.name}</a></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-xl font-extrabold text-slate-900">Related services</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((o) => (
          <a href={`/services/${o.slug}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600 hover:shadow-sm">
            <ServiceIcon slug={o.slug} />
            <span class="font-semibold text-slate-900">{o.name}</span>
          </a>
        ))}
      </div>
    </section>

    <FaqAccordion faqs={s.faqs} heading={`${s.name} FAQs`} id="faq" />
    <QuoteForm preselectService={s.slug} heading={`Get a free ${s.name.toLowerCase()} quote`} />
    <CtaBand heading="Pests don't wait. Neither should you." text={`One call and a licensed local technician is on the way. Same-day service available across ${SERVICE_AREA}.`} />
  </div>
</BaseLayout>
