---
import BaseLayout from "../components/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Reviews from "../components/Reviews.astro";
import CtaBand from "../components/CtaBand.astro";
import StatsBar from "../components/StatsBar.astro";
import { SITE_URL, PHONE_DISPLAY, telLink, SERVICE_AREA } from "../config";
import { faqSchema, localBusinessSchema, jsonLd } from "../lib/schema";
import homeData from "../data/home.json";
import servicesData from "../data/services.json";
import citiesData from "../data/cities.json";

const h = homeData.home;
const canonical = `${SITE_URL}/`;
const schemaHtml = jsonLd(
  localBusinessSchema({
    url: "/",
    areaServed: citiesData.cities.map((c) => c.name),
  }),
  faqSchema(homeData.globalFaqs)
);
const osceola = citiesData.cities.filter((c) => c.county === "Osceola County");
const orange = citiesData.cities.filter((c) => c.county === "Orange County");
---
<BaseLayout title={h.title} description={h.metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage="/images/hero.jpg">
  <!-- HERO -->
  <section aria-labelledby="hero-heading" class="relative isolate overflow-hidden bg-pine-950">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src="/images/hero.jpg"
        width="2048"
        height="1152"
        fetchpriority="high"
        decoding="async"
        alt="Golden-hour Florida home exterior with manicured lawn and warm evening light"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-pine-950/80 via-pine-950/60 to-pine-950/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-pine-950/80 via-pine-950/20 to-transparent"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 lg:pt-28 pb-12 lg:pb-16">
      <div class="max-w-3xl">
        <p class="eyebrow inline-flex items-center gap-2.5 rounded-full border border-gold-400/40 bg-gold-400/15 px-4 py-2 text-[13px] font-bold uppercase tracking-[0.14em] text-gold-300 backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-gold-400" aria-hidden="true"></span>
          {h.heroEyebrow}
        </p>
        <h1 id="hero-heading" class="mt-6 font-display text-5xl sm:text-6xl lg:text-7xl leading-[1.02] tracking-tight text-white text-balance">
          {h.heroHeadline}
        </h1>
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-pine-100">
          {h.heroSub}
        </p>
        <ul class="mt-8 space-y-3.5">
          {h.heroBullets.map((b) => (
            <li class="flex items-start gap-3 text-[17px] font-medium text-white">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold-400 text-pine-950" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="mt-9 flex flex-col sm:flex-row gap-4">
          <a
            href={telLink}
            class="btn-gold inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-gold-400 px-8 py-4 text-lg font-extrabold text-pine-950 shadow-xl shadow-black/25 transition hover:bg-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call {PHONE_DISPLAY}
          </a>
          <a
            href="#quote"
            class="btn-outline-light inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border-2 border-white/40 bg-white/5 px-8 py-4 text-lg font-bold text-white backdrop-blur-sm transition hover:border-white/70 hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none"
          >
            Get a Free Quote
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <p class="mt-5 text-sm font-medium tracking-wide text-pine-100/80">
          Serving {SERVICE_AREA} — from Kissimmee to Orlando.
        </p>
      </div>

      <div class="mt-12 lg:mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {h.trustBadges.map((b) => (
          <div class="rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur-md shadow-lg shadow-black/10">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold-400/20 text-gold-300 ring-1 ring-gold-400/30" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <p class="mt-4 font-bold text-white text-[17px] leading-snug">{b.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-pine-100/90">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <StatsBar
    stats={[
      { value: "2,400+", label: "Homes protected" },
      { value: "4.9", label: "Average rating" },
      { value: "Same-day", label: "Response time" },
      { value: "15", label: "Cities served" },
    ]}
  />

  <!-- SERVICES -->
  <section id="services" aria-labelledby="services-heading" class="reveal scroll-mt-24 bg-cream-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-pine-200 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-pine-700 shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-600" aria-hidden="true"></span>
          What we treat
        </p>
        <h2 id="services-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-ink-900 text-balance">
          Pest Control Services
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{h.servicesBlurb}</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="group flex flex-col overflow-hidden rounded-3xl border border-pine-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-900/10 hover:border-pine-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:transform-none"
          >
            <div class="relative overflow-hidden aspect-[16/10] bg-pine-100">
              <img
                src={`/images/service-${s.slug}.jpg`}
                alt={`${s.name} treatment in Central Florida by Orlando Pest Pros`}
                width="1920"
                height="1280"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none motion-reduce:transform-none"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-pine-950/25 via-transparent to-transparent opacity-80" aria-hidden="true"></div>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <h3 class="font-display text-xl leading-snug text-ink-900 group-hover:text-pine-800 transition-colors">{s.name}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-600 line-clamp-3">{s.intro[0]}</p>
              <span class="mt-5 inline-flex min-h-[24px] items-center gap-1.5 text-sm font-bold text-gold-700 group-hover:text-gold-600 group-hover:gap-2.5 transition-all">
                Learn more →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section aria-labelledby="how-heading" class="reveal relative overflow-hidden bg-pine-900 py-20 sm:py-24">
    <div class="pointer-events-none absolute -top-40 -right-32 h-[28rem] w-[28rem] rounded-full bg-pine-800 blur-3xl opacity-70" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-48 -left-32 h-[26rem] w-[26rem] rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-gold-300">
          Simple &amp; thorough
        </p>
        <h2 id="how-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-white text-balance">
          How It Works
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-pine-100/90">
          A clear visit from inspection to prevention, built for Florida homes.
        </p>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {h.howItWorks.map((st, i) => (
          <li class="rounded-3xl border border-white/10 bg-white/[0.06] p-7 backdrop-blur-sm shadow-lg shadow-black/10">
            <span class="font-display text-6xl leading-none text-gold-400" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <p class="mt-5 text-lg font-bold leading-snug text-white">{st.step}</p>
            <p class="mt-2.5 text-[15px] leading-relaxed text-pine-100/90">{st.detail}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={telLink}
          class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-gold-400 px-8 py-3.5 text-base font-extrabold text-pine-950 shadow-lg shadow-black/20 transition hover:bg-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-900"
        >
          Call {PHONE_DISPLAY}
        </a>
        <a
          href="#quote"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 px-8 py-3.5 text-base font-bold text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-900"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section aria-labelledby="why-heading" class="reveal bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-12 lg:gap-16 lg:grid-cols-[0.9fr_1.1fr] items-start">
      <div class="lg:sticky lg:top-28">
        <div class="relative overflow-hidden rounded-[2rem] border border-pine-100 shadow-2xl shadow-pine-900/20">
          <img
            src="/images/technician-trust.jpg"
            alt="Orlando Pest Pros technician smiling in uniform in front of a Florida home"
            width="1280"
            height="1920"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
          <div class="absolute inset-x-4 bottom-4 rounded-2xl border border-white/20 bg-pine-950/80 p-5 backdrop-blur-md" aria-hidden="false">
            <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-gold-300">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              Local &amp; licensed
            </p>
            <p class="mt-1.5 text-[15px] font-medium leading-relaxed text-white">
              Technicians who live here and treat for our soil, storms, and seasons.
            </p>
          </div>
        </div>
      </div>

      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-pine-200 bg-pine-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-pine-700">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-600" aria-hidden="true"></span>
          Why choose us
        </p>
        <h2 id="why-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight leading-[1.05] text-ink-900 text-balance">
          {h.whyUs.heading}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">{h.whyUs.intro}</p>

        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          {h.whyUs.points.map((p) => (
            <div class="rounded-3xl border border-pine-100 bg-cream-50 p-6 sm:p-7 shadow-sm">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-pine-700 text-gold-300" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <p class="mt-4 font-bold text-[17px] leading-snug text-ink-900">{p.title}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <div id="reviews" class="reveal scroll-mt-24">
    <Reviews reviews={homeData.reviews} aggregate={homeData.aggregateRating} id="reviews" />
  </div>

  <!-- SERVICE AREAS -->
  <section id="areas" aria-labelledby="areas-heading" class="reveal scroll-mt-24 bg-cream-50 py-20 sm:py-24 border-y border-pine-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-pine-200 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-pine-700 shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-600" aria-hidden="true"></span>
          Where we serve
        </p>
        <h2 id="areas-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-ink-900 text-balance">
          Service Areas
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{h.areasBlurb}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-pine-100 bg-white p-7 sm:p-8 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pine-700 text-gold-300" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <h3 class="font-display text-2xl text-ink-900">Osceola County</h3>
          </div>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {osceola.map((c) => (
              <li>
                <a
                  href={`/locations/${c.slug}/`}
                  class="flex min-h-[48px] items-center justify-between gap-2 rounded-xl border border-transparent px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-200 hover:bg-pine-50 hover:text-pine-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
                >
                  <span>Pest Control in {c.name}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl border border-pine-100 bg-white p-7 sm:p-8 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pine-700 text-gold-300" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <h3 class="font-display text-2xl text-ink-900">Orange County</h3>
          </div>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {orange.map((c) => (
              <li>
                <a
                  href={`/locations/${c.slug}/`}
                  class="flex min-h-[48px] items-center justify-between gap-2 rounded-xl border border-transparent px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-200 hover:bg-pine-50 hover:text-pine-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
                >
                  <span>Pest Control in {c.name}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="reveal">
    <FaqAccordion faqs={homeData.globalFaqs} heading="Pest Control FAQs" id="faq" />
  </div>

  <QuoteForm />

  <CtaBand heading={h.ctaBand.heading} text={h.ctaBand.text} />
</BaseLayout>
