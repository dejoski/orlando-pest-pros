---
import BaseLayout from "../components/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Reviews from "../components/Reviews.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE_URL, PHONE_DISPLAY, telLink, SERVICE_AREA } from "../config";
import { faqSchema, localBusinessSchema, jsonLd } from "../lib/schema";
import homeData from "../data/home.json";
import servicesData from "../data/services.json";
import citiesData from "../data/cities.json";

const h = homeData.home;
const canonical = `${SITE_URL}/`;
const schemaHtml = jsonLd(
  localBusinessSchema({
    url: "/",
    areaServed: citiesData.cities.map((c) => c.name),
  }),
  faqSchema(homeData.globalFaqs)
);
const osceola = citiesData.cities.filter((c) => c.county === "Osceola County");
const orange = citiesData.cities.filter((c) => c.county === "Orange County");

// Seasonal field notes: picked at build time from home.seasonal.
const now = new Date();
const month = now.getMonth();
const seasonKey = month >= 2 && month <= 4 ? "spring" : month >= 5 && month <= 7 ? "summer" : month >= 8 && month <= 10 ? "fall" : "winter";
const monthName = now.toLocaleString("en-US", { month: "long" });
const seasonalItems: string[] = (h as any).seasonal?.[seasonKey] ?? [];
const crew: { name: string; role: string; tenure: string; quote: string }[] = (h as any).crew ?? [];
---
<BaseLayout title={h.title} description={h.metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage="/images/hero.jpg">
  <!-- HERO -->
  <section aria-labelledby="hero-heading" class="relative isolate overflow-hidden bg-pine-950">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src="/images/hero.jpg"
        width="2048"
        height="1152"
        fetchpriority="high"
        decoding="async"
        alt="Golden-hour Florida home exterior with manicured lawn and warm evening light"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-pine-950/80 via-pine-950/60 to-pine-950/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-pine-950/80 via-pine-950/20 to-transparent"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 lg:pt-28 pb-14 lg:pb-20">
      <div class="max-w-3xl">
        <p class="eyebrow flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-gold-300">
          <span class="h-px w-10 bg-gold-400" aria-hidden="true"></span>
          {h.heroEyebrow}
        </p>
        <h1 id="hero-heading" class="mt-6 font-display text-5xl sm:text-6xl lg:text-7xl leading-[1.02] tracking-tight text-white text-balance">
          {h.heroHeadline}
        </h1>
        {(h as any).heroTagline && (
          <p class="mt-4 font-display text-2xl sm:text-3xl tracking-tight text-gold-300">
            {(h as any).heroTagline}
          </p>
        )}
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-pine-100">
          {h.heroSub}
        </p>
        <ul class="mt-8 space-y-0 border-t border-white/15">
          {h.heroBullets.map((b) => (
            <li class="flex items-baseline gap-4 border-b border-white/15 py-3.5 text-[17px] font-medium text-white">
              <span class="h-1.5 w-1.5 shrink-0 translate-y-[-3px] bg-gold-400" aria-hidden="true"></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="mt-9 flex flex-col gap-5 sm:flex-row sm:items-center">
          <a
            href={telLink}
            class="btn-gold inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-gold-400 px-8 py-4 text-lg font-extrabold text-pine-950 shadow-xl shadow-black/25 transition hover:bg-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call {PHONE_DISPLAY}
          </a>
          <a
            href="#quote"
            class="inline-flex min-h-[52px] items-center gap-2 px-1 py-4 text-lg font-bold text-white underline decoration-gold-400 decoration-2 underline-offset-8 hover:text-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none"
          >
            Get a free quote
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <p class="mt-5 text-sm font-medium tracking-wide text-pine-100/80">
          Serving {SERVICE_AREA} — from Kissimmee to Orlando.
        </p>
      </div>
    </div>
  </section>

  <!-- SEASONAL FIELD NOTES -->
  {seasonalItems.length > 0 && (
    <section aria-label="Current pest activity in Central Florida" class="border-t border-white/10 bg-pine-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center">
          <div class="shrink-0 lg:w-60">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold-400">In Central Florida right now</p>
            <p class="mt-1 text-sm text-white/50">{monthName} field notes</p>
          </div>
          <ul class="grid flex-1 gap-x-8 gap-y-3 sm:grid-cols-3">
            {seasonalItems.map((item) => (
              <li class="flex gap-3 text-[15px] leading-relaxed text-pine-100">
                <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- SERVICES -->
  <section id="services" aria-labelledby="services-heading" class="scroll-mt-24 bg-cream-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="flex items-center justify-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-pine-700">
          <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
          What we treat
          <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
        </p>
        <h2 id="services-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-ink-900 text-balance">
          Pest Control Services
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{h.servicesBlurb}</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s, i) => {
          const featured = i === 0;
          return (
          <a
            href={`/services/${s.slug}/`}
            class={
              "group overflow-hidden rounded-3xl border border-pine-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-900/10 hover:border-pine-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:transform-none " +
              (featured ? "grid sm:grid-cols-2 lg:col-span-2" : "flex flex-col")
            }
          >
            <div class={"relative overflow-hidden bg-pine-100 " + (featured ? "aspect-[16/10] sm:aspect-auto sm:h-full sm:min-h-[320px]" : "aspect-[16/10]")}>
              <img
                src={`/images/service-${s.slug}.jpg`}
                alt={`Illustration of ${s.name.toLowerCase()} treatment in a Central Florida home`}
                width="1920"
                height="1280"
                loading="lazy"
                decoding="async"
                class={"w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none motion-reduce:transform-none " + (featured ? "h-full sm:absolute sm:inset-0" : "h-full")}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-pine-950/25 via-transparent to-transparent opacity-80" aria-hidden="true"></div>
            </div>
            <div class={"flex flex-1 flex-col " + (featured ? "justify-center p-6 sm:p-10" : "p-6 sm:p-7")}>
              {featured && (
                <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.16em] text-gold-700">
                  Start here
                </p>
              )}
              <h3 class={"font-display leading-snug text-ink-900 group-hover:text-pine-800 transition-colors " + (featured ? "text-2xl sm:text-3xl" : "text-xl")}>{s.name}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-600 line-clamp-3">{s.intro[0]}</p>
              <span class="mt-5 inline-flex min-h-[24px] items-center gap-1.5 text-sm font-bold text-gold-700 group-hover:text-gold-600 group-hover:gap-2.5 transition-all">
                Learn more →
              </span>
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- POPULAR LOCAL SERVICES: direct links to priority city x service pages -->
  <section aria-labelledby="popular-heading" class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Most requested</p>
        <h2 id="popular-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">Popular local services</h2>
        <p class="mt-4 leading-relaxed text-ink-600">The pages homeowners in our busiest neighborhoods read first — local notes on what we actually find in each city, and how we treat it.</p>
      </div>
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { href: "/locations/orlando/general-pest-control/", label: "Pest Control in Orlando" },
          { href: "/locations/winter-garden/general-pest-control/", label: "Pest Control in Winter Garden" },
          { href: "/locations/kissimmee/termite-control/", label: "Termite Treatment in Kissimmee" },
          { href: "/locations/winter-garden/termite-control/", label: "Termite Treatment in Winter Garden" },
          { href: "/locations/kissimmee/general-pest-control/", label: "Pest Control in Kissimmee" },
          { href: "/locations/st-cloud/general-pest-control/", label: "Pest Control in St. Cloud" },
          { href: "/locations/st-cloud/termite-control/", label: "Termite Treatment in St. Cloud" },
          { href: "/locations/winter-garden/rodent-control/", label: "Rodent Control in Winter Garden" },
          { href: "/locations/kissimmee/wildlife-removal/", label: "Wildlife Removal in Kissimmee" },
          { href: "/locations/kissimmee/mosquito-control/", label: "Mosquito Control in Kissimmee" },
          { href: "/locations/lake-buena-vista/rodent-control/", label: "Rodent Control in Lake Buena Vista" },
          { href: "/locations/kissimmee/bed-bug-treatment/", label: "Bed Bug Treatment in Kissimmee" },
        ].map((l) => (
          <li>
            <a href={l.href} class="group flex min-h-[48px] items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-cream-50 px-5 py-4 font-semibold text-ink-900 transition hover:border-pine-600 hover:bg-white hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
              <span>{l.label}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-gold-600 transition group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section aria-label="Why homeowners choose Orlando Pest Pros" class="border-y border-pine-100 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <dl class="grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-pine-100">
        {h.trustBadges.map((b) => (
          <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
            <dt class="text-sm font-bold uppercase tracking-[0.12em] text-pine-800">{b.title}</dt>
            <dd class="mt-2 text-[15px] leading-relaxed text-ink-600">{b.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CREW -->
  {crew.length > 0 && (
    <section aria-labelledby="crew-heading" class="bg-cream-50 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-2xl">
            <p class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-pine-700">
              <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
              Who shows up
            </p>
            <h2 id="crew-heading" class="mt-4 font-display text-4xl sm:text-5xl tracking-tight text-ink-900 text-balance">
              One tech, start to finish
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-600">
              The person who inspects your home is the one who treats it — and the one who comes back free if anything stirs. Below are illustrative example profiles showing the kind of specialists we send, not photos of our actual staff.
            </p>
          </div>
          <p class="max-w-xs text-xs leading-relaxed text-ink-500 lg:text-right lg:pb-1">
            Illustrative example profiles — you'll meet your actual technician at your free inspection.
          </p>
        </div>
        <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
          {crew.map((t, i) => (
            <figure>
              <div class="overflow-hidden rounded-[2rem] shadow-lg shadow-pine-900/10">
                <img
                  src={`/images/crew-${i + 1}.jpg`}
                  alt={`Illustrative portrait representing a ${t.role} (example profile)`}
                  width="1024"
                  height="1280"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover"
                />
              </div>
              <figcaption class="mt-5">
                <p class="font-display text-xl text-ink-900">{t.name}</p>
                <p class="mt-1 text-xs font-bold uppercase tracking-[0.12em] text-pine-700">{t.role} · {t.tenure}</p>
                <blockquote class="mt-3 border-l-2 border-gold-400 pl-4 text-[15px] italic leading-relaxed text-ink-600">
                  "{t.quote}"
                </blockquote>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- WHY US -->
  <section aria-labelledby="why-heading" class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-12 lg:gap-16 lg:grid-cols-[0.9fr_1.1fr] items-start">
      <div class="lg:sticky lg:top-28">
        <div class="relative overflow-hidden rounded-[2rem] border border-pine-100 shadow-2xl shadow-pine-900/20">
          <img
            src="/images/technician-trust.jpg"
            alt="Orlando Pest Pros technician smiling in uniform in front of a Florida home"
            width="1280"
            height="1920"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
          <div class="absolute inset-x-4 bottom-4 rounded-2xl border border-white/20 bg-pine-950/80 p-5 backdrop-blur-md" aria-hidden="false">
            <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-gold-300">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              Local &amp; licensed
            </p>
            <p class="mt-1.5 text-[15px] font-medium leading-relaxed text-white">
              Technicians who live here and treat for our soil, storms, and seasons.
            </p>
          </div>
        </div>
      </div>

      <div>
        <p class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-pine-700">
          <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
          Why homeowners call us
        </p>
        <h2 id="why-heading" class="mt-4 font-display text-4xl sm:text-5xl tracking-tight leading-[1.05] text-ink-900 text-balance">
          {h.whyUs.heading}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">{h.whyUs.intro}</p>

        <div class="mt-9 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {h.whyUs.points.map((p, i) => (
            <div class="border-t-2 border-gold-400/70 pt-5">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-pine-700">{String(i + 1).padStart(2, "0")} — {p.title}</p>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-600">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section aria-labelledby="how-heading" class="bg-pine-900 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-gold-300">
          <span class="h-px w-10 bg-gold-400" aria-hidden="true"></span>
          Simple &amp; thorough
        </p>
        <h2 id="how-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-white text-balance">
          How It Works
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-pine-100/90">
          A clear visit from inspection to prevention, built for Florida homes.
        </p>
      </div>
      <ol class="mt-12">
        {h.howItWorks.map((st, i) => (
          <li class={`grid gap-4 border-t border-white/15 py-8 sm:grid-cols-[auto_1fr] sm:gap-10 ${i % 2 === 1 ? "lg:pl-24" : ""}`}>
            <span class="font-display text-5xl sm:text-6xl leading-none text-gold-400/90" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="max-w-2xl">
              <p class="text-xl font-bold leading-snug text-white">{st.step}</p>
              <p class="mt-2.5 text-[16px] leading-relaxed text-pine-100/90">{st.detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={telLink}
          class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-gold-400 px-8 py-3.5 text-base font-extrabold text-pine-950 shadow-lg shadow-black/20 transition hover:bg-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-900"
        >
          Call {PHONE_DISPLAY}
        </a>
        <a
          href="#quote"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 px-8 py-3.5 text-base font-bold text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-900"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section id="areas" aria-labelledby="areas-heading" class="scroll-mt-24 bg-cream-50 py-20 sm:py-24 border-y border-pine-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="flex items-center justify-center gap-3 text-[13px] font-bold uppercase tracking-[0.18em] text-pine-700">
          <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
          Where we serve
          <span class="h-px w-10 bg-gold-500" aria-hidden="true"></span>
        </p>
        <h2 id="areas-heading" class="mt-5 font-display text-4xl sm:text-5xl tracking-tight text-ink-900 text-balance">
          Service Areas
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{h.areasBlurb}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-pine-100 bg-white p-7 sm:p-8 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pine-700 text-gold-300" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <h3 class="font-display text-2xl text-ink-900">Osceola County</h3>
          </div>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {osceola.map((c) => (
              <li>
                <a
                  href={`/locations/${c.slug}/`}
                  class="flex min-h-[48px] items-center justify-between gap-2 rounded-xl border border-transparent px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-200 hover:bg-pine-50 hover:text-pine-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
                >
                  <span>Pest Control in {c.name}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl border border-pine-100 bg-white p-7 sm:p-8 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pine-700 text-gold-300" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <h3 class="font-display text-2xl text-ink-900">Orange County</h3>
          </div>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {orange.map((c) => (
              <li>
                <a
                  href={`/locations/${c.slug}/`}
                  class="flex min-h-[48px] items-center justify-between gap-2 rounded-xl border border-transparent px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-200 hover:bg-pine-50 hover:text-pine-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
                >
                  <span>Pest Control in {c.name}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <div id="reviews" class="scroll-mt-24 bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Reviews reviews={homeData.reviews} aggregate={homeData.aggregateRating} id="reviews" />
    </div>
  </div>

  <div class="border-t border-pine-100 bg-cream-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <FaqAccordion faqs={homeData.globalFaqs} heading="Pest Control FAQs" id="faq" />
      </div>
    </div>
  </div>

  <QuoteForm />

  <CtaBand heading={h.ctaBand.heading} text={h.ctaBand.text} />
</BaseLayout>
