---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE_URL } from "../config";
import citiesData from "../data/cities.json";
import servicesData from "../data/services.json";
import guidesData from "../data/guides.json";

// Human-readable HTML sitemap: one crawlable index of every page on the
// site, linked from the footer so crawlers (and visitors) always have a
// flat path to every city hub, service hub, and city x service page.
const canonical = `${SITE_URL}/sitemap/`;
---
<BaseLayout
  title="Sitemap | Orlando Pest Pros"
  description="Every Orlando Pest Pros page in one place: pest control services, service areas, and local service pages across Osceola & Orange Counties."
  canonical={canonical}
>
  <section class="bg-cream-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Site map</p>
      <h1 class="mt-3 font-display text-4xl tracking-tight text-ink-900 sm:text-5xl">All pages</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">
        Every service, service area, and local service page on the site — one click from here.
      </p>

      <h2 class="mt-12 font-display text-2xl tracking-tight text-ink-900">Services</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`} class="flex min-h-[48px] items-center rounded-xl border border-pine-100 bg-white px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-300 hover:bg-pine-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">{s.name}</a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 font-display text-2xl tracking-tight text-ink-900">Guides</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {guidesData.guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`} class="flex min-h-[48px] items-center rounded-xl border border-pine-100 bg-white px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-300 hover:bg-pine-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">{g.h1}</a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 font-display text-2xl tracking-tight text-ink-900">Service areas</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {citiesData.cities.map((c) => (
          <li>
            <a href={`/locations/${c.slug}/`} class="flex min-h-[48px] items-center rounded-xl border border-pine-100 bg-white px-4 py-3 font-semibold text-pine-800 transition hover:border-pine-300 hover:bg-pine-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">Pest Control in {c.name}</a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 font-display text-2xl tracking-tight text-ink-900">Local services by city</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {citiesData.cities.map((c) => (
          <div class="rounded-3xl border border-pine-100 bg-white p-6 shadow-sm">
            <h3 class="font-display text-lg text-ink-900">
              <a href={`/locations/${c.slug}/`} class="hover:text-pine-700 hover:underline hover:underline-offset-4">{c.name}</a>
            </h3>
            <ul class="mt-3 space-y-1 text-sm">
              {servicesData.services.map((s) => (
                <li>
                  <a href={`/locations/${c.slug}/${s.slug}/`} class="inline-flex min-h-[36px] items-center text-pine-800 hover:text-pine-950 hover:underline hover:underline-offset-4">{s.name} in {c.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
