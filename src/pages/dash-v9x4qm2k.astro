---
// src/pages/dash-v9x4qm2k.astro — PRIVATE analytics dashboard.
//
// Copy to `src/pages/dash-v9x4qm2k.astro`. The random suffix makes the path
// non-guessable; access additionally requires the token query param `?k=`
// matching the DASHBOARD_TOKEN env var (see SETUP.md).
// Full URL for Dejan: https://<site>/dash-v9x4qm2k?k=<DASHBOARD_TOKEN>
//
// Zero npm dependencies; plain inline styles so it renders without Tailwind.

export const prerender = false;

const TOKEN = import.meta.env.DASHBOARD_TOKEN;
if (!TOKEN || Astro.url.searchParams.get('k') !== TOKEN) {
  // 404 (not 403) so scanners can't tell the page exists.
  return new Response('Not found', { status: 404 });
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const TYPES = ['pv', 'tel', 'form_start', 'form_submit'];
const DAYS = 30;
const LEADS_KEY = 'opp:leads'; // Redis list written by src/lib/leads.ts (LPUSH, newest first)
const LEADS_SHOWN = 50;

function kvConfig() {
  const url = import.meta.env.KV_REST_API_URL || import.meta.env.UPSTASH_REDIS_REST_URL || '';
  const token = import.meta.env.KV_REST_API_TOKEN || import.meta.env.UPSTASH_REDIS_REST_TOKEN || '';
  if (!url || !token) return null;
  return { base: url.replace(/\/+$/, ''), token };
}

async function pipeline(commands) {
  const cfg = kvConfig();
  if (!cfg) return null;
  const res = await fetch(cfg.base + '/pipeline', {
    method: 'POST',
    headers: { Authorization: 'Bearer ' + cfg.token, 'Content-Type': 'application/json' },
    body: JSON.stringify(commands),
  });
  if (!res.ok) throw new Error('kv pipeline failed: ' + res.status);
  return res.json();
}

function dayStamp(offset) {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() - offset);
  return d.toISOString().slice(0, 10); // YYYY-MM-DD (UTC)
}

// Upstash HGETALL returns [field, value, ...] or null for a missing key.
function hashToObj(arr) {
  const o = {};
  if (Array.isArray(arr)) {
    for (let i = 0; i + 1 < arr.length; i += 2) o[arr[i]] = parseInt(arr[i + 1], 10) || 0;
  }
  return o;
}

// One hash per day: opp:day:YYYY-MM-DD, fields "{page}|{type}".
// Dashboard = 30 HGETALLs + LRANGE/LLEN on the leads list, in ONE pipeline.
let rows = [];
let totals = { pv: 0, tel: 0, form_start: 0, form_submit: 0 };
let leads = [];
let leadsTotal = 0;
let kvError = '';

try {
  const cfg = kvConfig();
  if (!cfg) {
    kvError = 'KV not connected: KV_REST_API_URL / KV_REST_API_TOKEN (or the UPSTASH_* pair) is missing. See SETUP.md.';
  } else {
    const cmds = [];
    for (let d = 0; d < DAYS; d++) cmds.push(['HGETALL', 'opp:day:' + dayStamp(d)]);
    cmds.push(['LRANGE', LEADS_KEY, 0, LEADS_SHOWN - 1]);
    cmds.push(['LLEN', LEADS_KEY]);
    const results = await pipeline(cmds);

    const perPage = {};
    for (const r of (results || []).slice(0, DAYS)) {
      const h = hashToObj(r && r.result);
      for (const [field, n] of Object.entries(h)) {
        const i = field.lastIndexOf('|');
        if (i < 0) continue;
        const page = field.slice(0, i);
        const type = field.slice(i + 1);
        if (!TYPES.includes(type)) continue;
        if (!perPage[page]) perPage[page] = { pv: 0, tel: 0, form_start: 0, form_submit: 0 };
        perPage[page][type] += n;
      }
    }

    rows = Object.entries(perPage)
      .map(([page, c]) => ({
        page,
        ...c,
        conv: c.pv > 0 ? (100 * c.form_submit) / c.pv : 0,
      }))
      .sort((a, b) => b.pv - a.pv);

    for (const r of rows) for (const t of TYPES) totals[t] += r[t];

    // Leads: pipeline results after the 30 HGETALLs are LRANGE then LLEN.
    const lrange = results && results[DAYS] ? results[DAYS].result : null;
    if (Array.isArray(lrange)) {
      for (const item of lrange) {
        try {
          const l = JSON.parse(item);
          if (l && l.name && l.phone) leads.push(l);
        } catch { /* skip malformed entries */ }
      }
    }
    const llen = results && results[DAYS + 1] ? results[DAYS + 1].result : null;
    leadsTotal = typeof llen === 'number' ? llen : leads.length;
  }
} catch (e) {
  kvError = 'Could not read analytics store: ' + (e && e.message ? e.message : e);
}

const totalConv = totals.pv > 0 ? (100 * totals.form_submit) / totals.pv : 0;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Analytics — Orlando Pest Pros (private)</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; margin: 0; background: #0f172a; color: #e2e8f0; }
    .wrap { max-width: 960px; margin: 0 auto; padding: 24px 16px 64px; }
    h1 { font-size: 20px; margin: 0 0 4px; }
    h2 { font-size: 16px; margin: 32px 0 4px; }
    .sub { color: #94a3b8; font-size: 13px; margin-bottom: 20px; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px; }
    .card { background: #1e293b; border-radius: 10px; padding: 14px; }
    .card .n { font-size: 26px; font-weight: 700; }
    .card .l { font-size: 12px; color: #94a3b8; margin-top: 2px; }
    table { width: 100%; border-collapse: collapse; background: #1e293b; border-radius: 10px; overflow: hidden; font-size: 14px; }
    th, td { text-align: right; padding: 10px 12px; border-bottom: 1px solid #334155; }
    th:first-child, td:first-child { text-align: left; }
    th { color: #94a3b8; font-weight: 600; font-size: 12px; text-transform: uppercase; }
    tr:last-child td { border-bottom: none; }
    .mono { font-family: ui-monospace, monospace; font-size: 13px; word-break: break-all; }
    table.leads th, table.leads td { text-align: left; vertical-align: top; }
    table.leads td.when { white-space: nowrap; color: #94a3b8; }
    .err { background: #7f1d1d; border-radius: 10px; padding: 14px; margin-bottom: 20px; }
    .conv { color: #4ade80; font-weight: 600; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Orlando Pest Pros — Analytics</h1>
    <div class="sub">Last {DAYS} days · UTC · private dashboard</div>

    {kvError && <div class="err">{kvError}</div>}

    <div class="cards">
      <div class="card"><div class="n">{totals.pv.toLocaleString()}</div><div class="l">Pageviews</div></div>
      <div class="card"><div class="n">{totals.tel.toLocaleString()}</div><div class="l">Call-link taps</div></div>
      <div class="card"><div class="n">{totals.form_start.toLocaleString()}</div><div class="l">Quote-form starts</div></div>
      <div class="card"><div class="n">{totals.form_submit.toLocaleString()}</div><div class="l">Quote-form submits</div></div>
      <div class="card"><div class="n">{totalConv.toFixed(1)}%</div><div class="l">Overall conversion (submit / pv)</div></div>
      <div class="card"><div class="n">{leadsTotal.toLocaleString()}</div><div class="l">Quote leads stored</div></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Page</th><th>Pageviews</th><th>Call taps</th><th>Form starts</th><th>Form submits</th><th>Conv. rate</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 && (
          <tr><td colspan="6" style="text-align:center; color:#94a3b8;">No data yet — events appear here after the first tracked visit.</td></tr>
        )}
        {rows.map((r) => (
          <tr>
            <td class="mono">{r.page}</td>
            <td>{r.pv.toLocaleString()}</td>
            <td>{r.tel.toLocaleString()}</td>
            <td>{r.form_start.toLocaleString()}</td>
            <td>{r.form_submit.toLocaleString()}</td>
            <td class="conv">{r.conv.toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Quote leads</h2>
    <div class="sub">Most recent {LEADS_SHOWN} stored leads · newest first · persisted by the quote form to the {LEADS_KEY} list</div>
    <table class="leads">
      <thead>
        <tr>
          <th>Submitted (UTC)</th><th>Name</th><th>Phone</th><th>Service</th><th>City</th><th>Message</th><th>Page</th>
        </tr>
      </thead>
      <tbody>
        {leads.length === 0 && (
          <tr><td colspan="7" style="text-align:center; color:#94a3b8;">No leads stored yet — submissions appear here once the KV store is connected and the form is used.</td></tr>
        )}
        {leads.map((l) => (
          <tr>
            <td class="when">{String(l.submittedAt || '').replace('T', ' ').slice(0, 16)}</td>
            <td>{l.name}</td>
            <td class="mono">{l.phone}</td>
            <td>{l.service}</td>
            <td>{l.city}</td>
            <td>{l.message || ''}</td>
            <td class="mono">{l.source || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</body>
</html>
