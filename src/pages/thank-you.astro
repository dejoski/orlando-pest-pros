---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE_URL, CONTACT_LABEL, telLink } from "../config";
---
<BaseLayout
  title="Thanks — We'll Be In Touch | Orlando Pest Pros"
  description="Your pest-control quote request has been saved."
  canonical={`${SITE_URL}/thank-you/`}
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-20 sm:py-28 text-center">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-pine-100">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 13l4 4L19 7" stroke="#1d4a33" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <h1 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight text-ink-900">Request received!</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-ink-600">Your request has been saved. If a suitable provider is available, they may contact you using the details you supplied. Submitting a request does not confirm an appointment, service availability, or a response time.</p>
    <p class="mt-4 text-ink-600">Have another question? <a href={telLink} class="font-bold text-pine-700 hover:underline">{CONTACT_LABEL}</a></p>
    <div class="mt-8">
      <a href="/" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-pine-700 px-7 py-3.5 font-bold text-white transition hover:bg-pine-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 motion-reduce:transition-none">Back to Home</a>
    </div>
  </div>
</BaseLayout>

