---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE_URL, PHONE_DISPLAY, telLink } from "../config";
---
<BaseLayout
  title="Thanks — We'll Be In Touch | Osceola Pest Pros"
  description="Your free quote request is in. A local Osceola Pest Pros technician will call you back the same business day."
  canonical={`${SITE_URL}/thank-you/`}
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-20 text-center">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-100">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 13l4 4L19 7" stroke="#166324" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <h1 class="mt-6 text-3xl sm:text-4xl font-extrabold text-slate-900">Request received!</h1>
    <p class="mt-3 text-lg text-slate-600">Thanks for reaching out — a local technician will call you back the <strong>same business day</strong> to schedule your free inspection.</p>
    <p class="mt-4 text-slate-600">Need help right now? <a href={telLink} class="font-bold text-brand-700 hover:underline">Call {PHONE_DISPLAY}</a></p>
    <div class="mt-8">
      <a href="/" class="inline-flex rounded-full bg-brand-700 px-7 py-3.5 font-extrabold text-white hover:bg-brand-800">Back to Home</a>
    </div>
  </div>
</BaseLayout>
