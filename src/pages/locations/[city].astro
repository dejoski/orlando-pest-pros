---
import BaseLayout from "../../components/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import CityPressure from "../../components/CityPressure.astro";
import CityNeighborhoods from "../../components/CityNeighborhoods.astro";
import { SITE_URL, CONTACT_LABEL, telLink } from "../../config";
import { faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../lib/schema";
import citiesData from "../../data/cities.json";
import servicesData from "../../data/services.json";

export async function getStaticPaths() {
  return citiesData.cities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const canonical = `${SITE_URL}/locations/${c.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Service Areas", url: "/#areas" },
  { name: c.name, url: `/locations/${c.slug}/` },
];
const schemaHtml = jsonLd(
  localBusinessSchema({ url: `/locations/${c.slug}/`, areaServed: [c.name] }),
  faqSchema(c.faqs),
  breadcrumbSchema(crumbs)
);

// Alternate section order and pest-list format per city so the 15 city pages
// don't read as one repeated template.
const flip = c.slug.charCodeAt(0) % 2 === 0;
const sectionEyebrows = ["Why it matters here", "Good to know", "Pest prevention"];


---
<BaseLayout title={c.title} description={c.metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage="/images/hero.jpg">
  <section class="relative overflow-hidden bg-pine-950">
    <img src="/images/hero.jpg" alt={`Illustration of homes in ${c.name}, Florida`} width="2048" height="1152" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 bg-pine-950/75"></div>
    <div class="relative mx-auto flex min-h-[480px] w-full max-w-7xl items-center px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <div class="text-white/70 [&_a]:text-white/70 [&_a]:underline-offset-4 hover:[&_a]:text-white [&_span]:text-white/70">
          <Breadcrumbs crumbs={crumbs} />
        </div>
        <p class="mt-6 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.14em] text-gold-300">
          <span class="h-px w-10 bg-gold-400" aria-hidden="true"></span>
          <span>Serving {c.name}, Florida{c.county ? ` · ${c.county}` : ""}</span>
        </p>
        <h1 class="mt-5 font-display text-4xl leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">{c.h1}</h1>
        <div class="mt-6 space-y-4">
          {c.intro.map((p) => <p class="text-lg leading-relaxed text-white/80">{p}</p>)}
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={telLink} class="btn-gold inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {CONTACT_LABEL}
          </a>
          <a href="#quote" class="btn-outline-light inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none">
            Get a Free Quote
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-white/70">
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Local pest information
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Inspection guidance
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Built for Florida climate
          </li>
        </ul>
      </div>
    </div>
  </section>

  {flip ? (
    <><CityNeighborhoods c={c} bordered={false} /><CityPressure c={c} variant="list" /></>
  ) : (
    <><CityPressure c={c} variant="cards" /><CityNeighborhoods c={c} bordered={true} /></>
  )}

  {c.sections.map((sec, idx) => (
    <section class="bg-white py-20 lg:py-24" aria-labelledby={`city-section-${idx}`}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">{sectionEyebrows[idx % sectionEyebrows.length]}</p>
          <h2 id={`city-section-${idx}`} class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{sec.heading}</h2>
          <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
        </div>
        <div class="mt-6 max-w-3xl space-y-4">
          {sec.body.map((p) => <p class="leading-relaxed text-ink-600">{p}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section aria-labelledby="city-services-heading" class="bg-pine-950 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Full-service care</p>
          <h2 id="city-services-heading" class="mt-3 font-display text-3xl tracking-tight text-white sm:text-4xl">Pest-control options in {c.name}</h2>
          <p class="mt-4 leading-relaxed text-white/70">Describe your pest problem and ask an independent provider about inspection, treatment, pricing, and scheduling.</p>
        </div>
        <a href={telLink} class="inline-flex min-h-[48px] shrink-0 items-center justify-center rounded-full bg-white/10 border border-white/20 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none">{CONTACT_LABEL}</a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s) => (
          <a href={`/locations/${c.slug}/${s.slug}/`} class="group overflow-hidden rounded-3xl border border-white/10 bg-white transition hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950 motion-reduce:transition-none">
            <span class="block overflow-hidden">
              <img src={`/images/service-${s.slug}.jpg`} alt={`${s.name} in ${c.name} — Orlando Pest Pros`} loading="lazy" decoding="async" width="1920" height="1280" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:transform-none" />
            </span>
            <span class="block p-6">
              <span class="flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-pine-50 text-pine-800" aria-hidden="true">
                  <ServiceIcon slug={s.slug} />
                </span>
                <span class="font-display text-lg tracking-tight text-ink-900 group-hover:text-pine-800">{s.name} in {c.name}</span>
              </span>
              <span class="mt-3 block text-sm leading-relaxed text-ink-600 line-clamp-2">{s.metaDescription}</span>
              <span class="mt-4 flex items-center gap-1.5 text-sm font-bold text-pine-700">Learn more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-white">
    <div class="mx-auto max-w-7xl space-y-16 px-4 py-20 sm:px-6 lg:space-y-20 lg:px-8 lg:py-24">
      <FaqAccordion faqs={c.faqs} heading={`Pest control in ${c.name}: FAQs`} id="faq" />
      <QuoteForm preselectCity={c.slug} heading={`Get a free quote in ${c.name}`} />
      <CtaBand heading={`${c.name} homeowners: reclaim your home today.`} text="Explore pest-control options for Central Florida homes and request information about availability and treatment." />
    </div>
  </div>
</BaseLayout>

