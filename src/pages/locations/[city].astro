---
import BaseLayout from "../../components/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { SITE_URL, PHONE_DISPLAY, telLink } from "../../config";
import { faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../lib/schema";
import citiesData from "../../data/cities.json";
import servicesData from "../../data/services.json";

export async function getStaticPaths() {
  return citiesData.cities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const canonical = `${SITE_URL}/locations/${c.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Service Areas", url: "/#areas" },
  { name: c.name, url: `/locations/${c.slug}/` },
];
const schemaHtml = jsonLd(
  localBusinessSchema({ url: `/locations/${c.slug}/`, areaServed: [c.name] }),
  faqSchema(c.faqs),
  breadcrumbSchema(crumbs)
);
---
<BaseLayout title={c.title} description={c.metaDescription} canonical={canonical} schemaHtml={schemaHtml}>
  <div class="bg-brand-50/60 border-b border-brand-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-6 max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-white border border-brand-200 px-4 py-1.5 text-sm font-semibold text-brand-800">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 1114 0c0 5.5-7 11-7 11z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
          Serving {c.name}, Florida{c.county ? ` · ${c.county}` : ""}
        </div>
        <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold text-slate-900 leading-tight">{c.h1}</h1>
        {c.intro.map((p) => <p class="mt-4 text-lg text-slate-600 leading-relaxed">{p}</p>)}
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href={telLink} class="inline-flex justify-center items-center gap-2 rounded-full bg-brand-700 px-7 py-3.5 font-extrabold text-white hover:bg-brand-800">Call {PHONE_DISPLAY}</a>
          <a href="#quote" class="inline-flex justify-center items-center gap-2 rounded-full bg-accent-500 px-7 py-3.5 font-extrabold text-slate-900 hover:bg-accent-600">Get a Free Quote</a>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 space-y-14">
    <section>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{c.localPressure.heading}</h2>
      {c.localPressure.body.map((p) => <p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">{p}</p>)}
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {c.localPests.map((p) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="font-bold text-slate-900">{p.name}</p>
            <p class="mt-1 text-sm text-slate-600">{p.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="neighborhoods-heading">
      <h2 id="neighborhoods-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900">Areas we serve in {c.name}</h2>
      <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {c.areasServed.map((a) => (
          <li class="flex items-start gap-2 rounded-xl bg-brand-50 px-4 py-3 text-sm font-medium text-brand-900">
            <span aria-hidden="true" class="text-brand-600">✓</span> {a}
          </li>
        ))}
      </ul>
    </section>

    {c.sections.map((sec) => (
      <section>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{sec.heading}</h2>
        {sec.body.map((p) => <p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">{p}</p>)}
      </section>
    ))}

    <section aria-labelledby="city-services-heading">
      <h2 id="city-services-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900">Our services in {c.name}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s) => (
          <a href={`/locations/${c.slug}/${s.slug}/`} class="group rounded-2xl border border-slate-200 bg-white p-5 hover:border-brand-600 hover:shadow-md transition">
            <ServiceIcon slug={s.slug} />
            <p class="mt-3 font-bold text-slate-900 group-hover:text-brand-800">{s.name} in {c.name}</p>
            <p class="mt-1 text-sm text-slate-600 line-clamp-2">{s.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>

    <FaqAccordion faqs={c.faqs} heading={`Pest control in ${c.name}: FAQs`} id="faq" />
    <QuoteForm preselectCity={c.slug} heading={`Get a free quote in ${c.name}`} />
    <CtaBand heading={`${c.name} homeowners: reclaim your home today.`} text="Local technicians, honest inspections, and treatments that work in Central Florida's climate. Call now for same-day availability." />
  </div>
</BaseLayout>
