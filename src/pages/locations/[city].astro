---
import BaseLayout from "../../components/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { SITE_URL, PHONE_DISPLAY, telLink } from "../../config";
import { faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../lib/schema";
import citiesData from "../../data/cities.json";
import servicesData from "../../data/services.json";

export async function getStaticPaths() {
  return citiesData.cities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const canonical = `${SITE_URL}/locations/${c.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Service Areas", url: "/#areas" },
  { name: c.name, url: `/locations/${c.slug}/` },
];
const schemaHtml = jsonLd(
  localBusinessSchema({ url: `/locations/${c.slug}/`, areaServed: [c.name] }),
  faqSchema(c.faqs),
  breadcrumbSchema(crumbs)
);
---
<BaseLayout title={c.title} description={c.metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage="/images/hero.jpg">
  <section class="relative overflow-hidden bg-pine-950">
    <img src="/images/hero.jpg" alt={`Homes in ${c.name}, Florida served by Orlando Pest Pros`} width="2048" height="1152" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 bg-pine-950/75"></div>
    <div class="relative mx-auto flex min-h-[480px] w-full max-w-7xl items-center px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <div class="text-white/70 [&_a]:text-white/70 [&_a]:underline-offset-4 hover:[&_a]:text-white [&_span]:text-white/70">
          <Breadcrumbs crumbs={crumbs} />
        </div>
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 1114 0c0 5.5-7 11-7 11z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
          <span>Serving {c.name}, Florida{c.county ? ` · ${c.county}` : ""}</span>
        </div>
        <h1 class="mt-5 font-display text-4xl leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">{c.h1}</h1>
        <div class="mt-6 space-y-4">
          {c.intro.map((p) => <p class="text-lg leading-relaxed text-white/80">{p}</p>)}
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={telLink} class="btn-gold inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Call {PHONE_DISPLAY}
          </a>
          <a href="#quote" class="btn-outline-light inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">
            Get a Free Quote
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-white/70">
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Local technicians
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Honest inspections
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Built for Florida climate
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="reveal bg-white py-20 lg:py-24" aria-labelledby="pressure-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Local pressure</p>
        <h2 id="pressure-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{c.localPressure.heading}</h2>
        <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
      </div>
      <div class="mt-6 max-w-3xl space-y-4">
        {c.localPressure.body.map((p) => <p class="leading-relaxed text-ink-600">{p}</p>)}
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.localPests.map((p) => (
          <div class="rounded-3xl border border-slate-200 bg-cream-50 p-6 shadow-sm motion-safe:transition hover:shadow-md">
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-pine-700 text-white" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            </span>
            <p class="mt-4 font-bold text-ink-900">{p.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="neighborhoods-heading" class="reveal border-y border-slate-200 bg-cream-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Neighborhoods</p>
        <h2 id="neighborhoods-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">Areas we serve in {c.name}</h2>
      </div>
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {c.areasServed.map((a) => (
          <li class="flex min-h-[48px] items-center gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-4 text-sm font-semibold text-ink-900 shadow-sm">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold-400 text-pine-950" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {a}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {c.sections.map((sec, idx) => (
    <section class="reveal bg-white py-20 lg:py-24" aria-labelledby={`city-section-${idx}`}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Why it matters here</p>
          <h2 id={`city-section-${idx}`} class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{sec.heading}</h2>
          <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
        </div>
        <div class="mt-6 max-w-3xl space-y-4">
          {sec.body.map((p) => <p class="leading-relaxed text-ink-600">{p}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section aria-labelledby="city-services-heading" class="reveal bg-pine-950 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Full-service care</p>
          <h2 id="city-services-heading" class="mt-3 font-display text-3xl tracking-tight text-white sm:text-4xl">Our services in {c.name}</h2>
          <p class="mt-4 leading-relaxed text-white/70">Every visit starts with a careful inspection and a plan built for Central Florida homes.</p>
        </div>
        <a href={telLink} class="inline-flex min-h-[48px] shrink-0 items-center justify-center rounded-full bg-white/10 border border-white/20 px-6 py-3 text-sm font-bold text-white motion-safe:transition hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">Call {PHONE_DISPLAY}</a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {servicesData.services.map((s) => (
          <a href={`/locations/${c.slug}/${s.slug}/`} class="group overflow-hidden rounded-3xl border border-white/10 bg-white motion-safe:transition hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">
            <span class="block overflow-hidden">
              <img src={`/images/service-${s.slug}.jpg`} alt={`${s.name} in ${c.name} — Orlando Pest Pros`} loading="lazy" decoding="async" width="1920" height="1280" class="aspect-[16/10] w-full object-cover motion-safe:transition motion-safe:duration-500 motion-safe:group-hover:scale-105" />
            </span>
            <span class="block p-6">
              <span class="flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-pine-50 text-pine-800" aria-hidden="true">
                  <ServiceIcon slug={s.slug} />
                </span>
                <span class="font-display text-lg tracking-tight text-ink-900 group-hover:text-pine-800">{s.name} in {c.name}</span>
              </span>
              <span class="mt-3 block text-sm leading-relaxed text-ink-600 line-clamp-2">{s.metaDescription}</span>
              <span class="mt-4 flex items-center gap-1.5 text-sm font-bold text-pine-700">Learn more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-white">
    <div class="mx-auto max-w-7xl space-y-16 px-4 py-20 sm:px-6 lg:space-y-20 lg:px-8 lg:py-24">
      <FaqAccordion faqs={c.faqs} heading={`Pest control in ${c.name}: FAQs`} id="faq" />
      <QuoteForm preselectCity={c.slug} heading={`Get a free quote in ${c.name}`} />
      <CtaBand heading={`${c.name} homeowners: reclaim your home today.`} text="Local technicians, honest inspections, and treatments that work in Central Florida's climate. Call now for same-day availability." />
    </div>
  </div>
</BaseLayout>
