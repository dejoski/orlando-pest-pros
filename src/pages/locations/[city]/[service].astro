---
import BaseLayout from "../../../components/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import QuoteForm from "../../../components/QuoteForm.astro";
import CtaBand from "../../../components/CtaBand.astro";
import ServiceIcon from "../../../components/ServiceIcon.astro";
import { SITE_URL, PHONE_DISPLAY, telLink } from "../../../config";
import { serviceSchema, faqSchema, breadcrumbSchema, localBusinessSchema, jsonLd } from "../../../lib/schema";
import citiesData from "../../../data/cities.json";
import servicesData from "../../../data/services.json";
import keywordsData from "../../../data/keywords.json";
import pageOverrides from "../../../data/page-overrides.json";

// Data-driven programmatic SEO: every city × service combination is
// generated from the two data files — no hand-written files needed.
export async function getStaticPaths() {
  const paths: { params: { city: string; service: string }; props: { c: any; s: any } }[] = [];
  for (const c of citiesData.cities) {
    for (const s of servicesData.services) {
      paths.push({ params: { city: c.slug, service: s.slug }, props: { c, s } });
    }
  }
  return paths;
}

const { c, s } = Astro.props;
// Hand-written per-page content overrides (de-templating): when a
// city/service pair has an entry in data/page-overrides.json, its local
// copy replaces the shared service/city boilerplate below. Pages without
// an override render exactly as before.
const ov: any = (pageOverrides as Record<string, any>)[`${c.slug}/${s.slug}`] ?? null;
// Primary money keyword from research/market-research.md (via data/keywords.json).
const kw = keywordsData[`${c.slug}/${s.slug}`] ?? { title: `${s.name} in ${c.name}, FL | Orlando Pest Pros`, h1: `${s.name} in ${c.name}, FL`, meta: s.metaDescription };
const title = kw.title;
const metaDescription = kw.meta;
const canonical = `${SITE_URL}/locations/${c.slug}/${s.slug}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: c.name, url: `/locations/${c.slug}/` },
  { name: s.name, url: `/locations/${c.slug}/${s.slug}/` },
];
const faqs = [...s.faqs.slice(0, 3), ...c.faqs.slice(0, 2)];
const sameCounty = citiesData.cities.filter((x) => x.slug !== c.slug && x.county === c.county);
const otherCounty = citiesData.cities.filter((x) => x.slug !== c.slug && x.county !== c.county);
const nearbyCities = [...sameCounty, ...otherCounty].slice(0, 8);
const otherServices = servicesData.services.filter((x) => x.slug !== s.slug);
const whyVariant = (c.slug.length + s.slug.length) % 2 === 0;
const whyHeading = ov?.whyHeading ?? (whyVariant
  ? `The ${s.name.toLowerCase()} problem in ${c.name}`
  : `Why ${c.name} needs professional ${s.name.toLowerCase()}`);
const schemaHtml = jsonLd(
  serviceSchema({ name: `${s.name} in ${c.name}`, description: metaDescription, url: `/locations/${c.slug}/${s.slug}/` }),
  localBusinessSchema({ url: `/locations/${c.slug}/${s.slug}/`, areaServed: [c.name] }),
  faqSchema(faqs),
  breadcrumbSchema(crumbs)
);
---
<BaseLayout title={title} description={metaDescription} canonical={canonical} schemaHtml={schemaHtml} preloadImage={`/images/service-${s.slug}.jpg`}>
  <section class="relative overflow-hidden bg-pine-950">
    <img src={`/images/service-${s.slug}.jpg`} alt={`Illustration of ${s.name.toLowerCase()} treatment in ${c.name}`} width="1920" height="1280" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 bg-pine-950/75"></div>
    <div class="relative mx-auto flex min-h-[480px] w-full max-w-7xl items-center px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <div class="text-white/70 [&_a]:text-white/70 [&_a]:underline-offset-4 hover:[&_a]:text-white [&_span]:text-white/70">
          <Breadcrumbs crumbs={crumbs} />
        </div>
        <p class="mt-6 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.14em] text-gold-300">
          <span class="h-px w-10 bg-gold-400" aria-hidden="true"></span>
          <span class="flex items-center gap-2">
            <span aria-hidden="true" class="text-gold-300"><ServiceIcon slug={s.slug} /></span>
            <span>{s.name} · {c.name}, FL</span>
          </span>
        </p>
        <h1 class="mt-5 font-display text-4xl leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">{kw.h1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-white/80">{ov?.heroLocal ?? c.localPressure.body[0]}</p>
        <p class="mt-4 text-lg leading-relaxed text-white/80">{ov?.heroService ?? s.intro[0]}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={telLink} class="btn-gold inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Call {PHONE_DISPLAY}
          </a>
          <a href="#quote" class="btn-outline-light inline-flex min-h-[48px] items-center justify-center gap-2 px-7 py-3.5 motion-safe:transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">
            Get a Free Quote
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24" aria-labelledby="why-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">{c.name} · {c.county}</p>
        <h2 id="why-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{whyHeading}</h2>
        <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
      </div>
      <div class="mt-6 max-w-3xl space-y-4">
        <p class="leading-relaxed text-ink-600">{ov?.whyLead ?? (s.sections[0]?.body[0] ?? s.intro[1])}</p>
        <p class="leading-relaxed text-ink-600">{ov?.whyLocal ?? (c.localPressure.body[1] ?? c.intro[1])}</p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {(ov?.pests ?? s.pests).slice(0, 6).map((p: any) => (
          <div class="rounded-3xl border border-slate-200 bg-cream-50 p-6 shadow-sm motion-safe:transition hover:shadow-md">
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-pine-700 text-white" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            </span>
            <p class="mt-4 font-bold text-ink-900">{p.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  {ov?.localSection && (
  <section aria-labelledby="local-heading" class="border-t border-slate-200 bg-cream-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">{c.name} · {s.name}</p>
        <h2 id="local-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{ov.localSection.heading}</h2>
        <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
      </div>
      <div class="mt-6 max-w-3xl space-y-4">
        {ov.localSection.body.map((para: string) => (
          <p class="leading-relaxed text-ink-600">{para}</p>
        ))}
      </div>
    </div>
  </section>
  )}

  <section aria-labelledby="process-heading" class="relative overflow-hidden bg-pine-950 py-20 lg:py-24">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">What to expect</p>
        <h2 id="process-heading" class="mt-3 font-display text-3xl tracking-tight text-white sm:text-4xl">Our {s.name.toLowerCase()} process in {c.name}</h2>
        <p class="mt-4 leading-relaxed text-white/70">{ov?.processIntro ?? "A clear plan, careful treatment, and a final check with your technician."}</p>
      </div>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {(ov?.process ?? s.process).map((st: any, i: number) => (
          <li class="rounded-3xl border border-white/10 bg-white/5 p-6 motion-safe:transition hover:bg-white/10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gold-400 font-display text-lg font-bold text-pine-950" aria-hidden="true">{i + 1}</span>
            <p class="mt-4 font-bold text-white">{st.step}</p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{st.detail}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={telLink} class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-gold-400 px-7 py-3.5 font-bold text-pine-950 motion-safe:transition hover:bg-gold-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">Call {PHONE_DISPLAY}</a>
        <a href="#quote" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-white/20 px-7 py-3.5 font-bold text-white motion-safe:transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-pine-950">Get a Free Quote</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="nearby-heading" class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Nearby cities</p>
        <h2 id="nearby-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{s.name} in nearby cities</h2>
      </div>
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {nearbyCities.map((x) => (
          <li>
            <a href={`/locations/${x.slug}/${s.slug}/`} class="group flex min-h-[48px] items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-cream-50 px-5 py-4 font-semibold text-ink-900 motion-safe:transition hover:border-pine-600 hover:bg-white hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
              <span>{s.name} in {x.name}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-gold-600 motion-safe:transition motion-safe:group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="other-services-heading" class="border-t border-slate-200 bg-cream-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="other-services-heading" class="font-display text-2xl tracking-tight text-ink-900 sm:text-3xl">Other services in {c.name}</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((o) => (
          <a href={`/locations/${c.slug}/${o.slug}/`} class="group flex min-h-[48px] items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 motion-safe:transition hover:border-pine-600 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-pine-50 text-pine-800" aria-hidden="true">
              <ServiceIcon slug={o.slug} />
            </span>
            <span class="font-semibold text-ink-900 group-hover:text-pine-800">{o.name} in {c.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-white">
    <div class="mx-auto max-w-7xl space-y-16 px-4 py-20 sm:px-6 lg:space-y-20 lg:px-8 lg:py-24">
      <FaqAccordion faqs={faqs} heading={`${s.name} in ${c.name}: FAQs`} id="faq" />
      <QuoteForm preselectService={s.slug} preselectCity={c.slug} heading={`Get a free ${s.name.toLowerCase()} quote in ${c.name}`} />
      <CtaBand heading={`${s.name} in ${c.name} — done right the first time.`} text="Licensed local technicians, honest inspections, and a satisfaction guarantee on every visit." />
    </div>
  </div>
</BaseLayout>
