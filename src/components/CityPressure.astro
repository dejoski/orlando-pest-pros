---
interface Props {
  c: any;
  variant: "cards" | "list";
}
const { c, variant } = Astro.props;
---
<section class={variant === "list" ? "border-b border-slate-200 bg-white py-20 lg:py-24" : "bg-white py-20 lg:py-24"} aria-labelledby="pressure-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">{variant === "list" ? "What we're seeing" : "Local pressure"}</p>
      <h2 id="pressure-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">{c.localPressure.heading}</h2>
      <div aria-hidden="true" class="mt-5 h-1 w-16 rounded-full bg-gold-400"></div>
    </div>
    <div class="mt-6 max-w-3xl space-y-4">
      {c.localPressure.body.map((p: string) => <p class="leading-relaxed text-ink-600">{p}</p>)}
    </div>
    {variant === "list" ? (
      <ol class="mt-10 divide-y divide-slate-200 overflow-hidden rounded-3xl border border-slate-200 bg-cream-50">
        {c.localPests.map((p: any, i: number) => (
          <li class="flex gap-5 px-6 py-5 sm:px-8">
            <span class="font-display text-2xl leading-none text-gold-600" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="font-bold text-ink-900">{p.name}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.localPests.map((p: any) => (
          <div class="rounded-3xl border border-slate-200 bg-cream-50 p-6 shadow-sm transition hover:shadow-md motion-reduce:transition-none">
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-pine-700 text-white" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            </span>
            <p class="mt-4 font-bold text-ink-900">{p.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
