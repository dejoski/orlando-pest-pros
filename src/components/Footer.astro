---
import LogoMark from "./LogoMark.astro";
import { SITE_NAME, PHONE_DISPLAY, telLink, HOURS, SERVICE_AREA } from "../config";
import services from "../data/services.json";
import cities from "../data/cities.json";
const year = new Date().getFullYear();
---
<footer class="bg-pine-950 text-pine-100">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <LogoMark size={36} />
        <p class="font-display text-2xl font-bold text-white">{SITE_NAME}</p>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-pine-100">Local pest control serving {SERVICE_AREA} — from Kissimmee to Orlando. Proudly serving Osceola &amp; Orange Counties.</p>
      <p class="mt-4 text-sm"><span class="font-semibold text-gold-300">Hours:</span> <span class="text-pine-100">{HOURS}</span></p>
      <a href={telLink} class="mt-6 inline-flex min-h-[52px] items-center gap-2 rounded-full bg-gold-400 px-6 py-3 text-sm font-bold text-pine-950 shadow-lg shadow-gold-500/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-gold-300">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Call {PHONE_DISPLAY}
      </a>
    </div>
    <nav aria-label="Services">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Services</p>
      <ul class="mt-4 space-y-1 text-sm">
        {services.services.map((s) => (
          <li><a href={`/services/${s.slug}/`} class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">{s.name}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Service areas">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Service Areas</p>
      <ul class="mt-4 space-y-1 text-sm">
        {cities.cities.map((c) => (
          <li><a href={`/locations/${c.slug}/`} class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">Pest Control in {c.name}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-gold-300">Company</p>
      <ul class="mt-4 space-y-1 text-sm">
        <li><a href="/#reviews" class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">Reviews</a></li>
        <li><a href="/#faq" class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">FAQ</a></li>
        <li><a href="/#quote" class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">Get a Free Quote</a></li>
        <li><a href="/sitemap/" class="inline-flex min-h-[40px] items-center text-pine-100 hover:text-white hover:underline hover:underline-offset-4">Sitemap</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-pine-800">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-2 px-4 py-6 text-xs text-pine-100/70 sm:flex-row sm:px-6">
      <p>© {year} {SITE_NAME}. All rights reserved.</p>
      <p>Serving Osceola &amp; Orange Counties · Kissimmee · St. Cloud · Orlando · Winter Park · + 11 more cities</p>
    </div>
  </div>
</footer>
