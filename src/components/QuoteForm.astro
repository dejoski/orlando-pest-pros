---
import { PHONE_DISPLAY, telLink, HAS_PHONE, LEAD_ENDPOINT } from "../config";
import services from "../data/services.json";
import cities from "../data/cities.json";

interface Props {
  heading?: string;
  sub?: string;
  preselectService?: string;
  preselectCity?: string;
}
const {
  heading = "Get Your Free Quote",
  sub = "Tell us what you are seeing and request contact from a local pest-control provider.",
  preselectService = "",
  preselectCity = "",
} = Astro.props;
---
<section id="quote" class="relative scroll-mt-24 overflow-hidden rounded-[2rem] bg-pine-900 p-6 text-white shadow-2xl sm:p-10 lg:p-12" aria-labelledby="quote-heading">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-6 top-0 h-1 rounded-full bg-gold-400/70 sm:inset-x-10"></div>
  <div class="relative grid gap-10 lg:grid-cols-2 lg:gap-12">
    <div>
      <p class="eyebrow text-gold-400">Local pest-control quote request</p>
      <h2 id="quote-heading" class="mt-3 font-display text-3xl font-bold text-balance sm:text-4xl">{heading}</h2>
      <p class="mt-3 leading-relaxed text-pine-100">{sub}</p>
      <ul class="mt-7 space-y-0 border-t border-white/15 text-[15px] font-medium">
        <li class="border-b border-white/15 py-3">Share your pest problem and location</li>
        <li class="border-b border-white/15 py-3">Discuss pricing and availability with a provider</li>
        <li class="border-b border-white/15 py-3">Choose whether to proceed after discussing your needs</li>
      </ul>
      {HAS_PHONE && <p class="mt-8 text-pine-100">Prefer to talk? <a href={telLink} class="font-bold text-white underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-gold-300">Call {PHONE_DISPLAY}</a></p>}
    </div>
    <form id="quote-form" data-quote-form action={LEAD_ENDPOINT} method="POST" class="rounded-3xl bg-white p-6 text-slate-800 shadow-xl sm:p-7" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="qf-name" class="mb-1.5 block text-sm font-semibold text-pine-950">Name *</label>
          <input id="qf-name" name="name" type="text" autocomplete="name" required placeholder="Jane Rivera"
            class="min-h-[48px] w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-pine-700 focus:outline-none focus:ring-2 focus:ring-gold-400/60" />
        </div>
        <div>
          <label for="qf-phone" class="mb-1.5 block text-sm font-semibold text-pine-950">Phone *</label>
          <input id="qf-phone" name="phone" type="tel" autocomplete="tel" required placeholder="(407) 555-0134"
            class="min-h-[48px] w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-pine-700 focus:outline-none focus:ring-2 focus:ring-gold-400/60" />
        </div>
        <div>
          <label for="qf-service" class="mb-1.5 block text-sm font-semibold text-pine-950">Service *</label>
          <select id="qf-service" name="service" required
            class="min-h-[48px] w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-pine-700 focus:outline-none focus:ring-2 focus:ring-gold-400/60">
            <option value="">Select a service…</option>
            {services.services.map((s) => (
              <option value={s.name} selected={s.slug === preselectService}>{s.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="qf-city" class="mb-1.5 block text-sm font-semibold text-pine-950">City *</label>
          <select id="qf-city" name="city" required
            class="min-h-[48px] w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-pine-700 focus:outline-none focus:ring-2 focus:ring-gold-400/60">
            <option value="">Select your city…</option>
            {cities.cities.map((c) => (
              <option value={c.name} selected={c.slug === preselectCity}>{c.name}</option>
            ))}
            <option value="Other (Orlando area)">Other (Orlando area)</option>
          </select>
        </div>
      </div>
      <div class="mt-4">
        <label for="qf-message" class="mb-1.5 block text-sm font-semibold text-pine-950">What are you seeing? <span class="font-normal text-slate-500">(optional)</span></label>
        <textarea id="qf-message" name="message" rows="3"
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-pine-700 focus:outline-none focus:ring-2 focus:ring-gold-400/60"
          placeholder="e.g. Palmetto bugs in the kitchen at night…"></textarea>
      </div>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <input type="hidden" name="form_started_at" value="" data-qf-started />
      <input type="hidden" name="source_page" value="" data-qf-source />
      <p id="qf-error" class="mt-3 hidden rounded-xl border border-pine-200 bg-pine-50 px-4 py-2.5 text-sm font-medium text-pine-900" role="alert"></p>
      <button type="submit" id="qf-submit"
        class="btn btn-gold mt-5 w-full">
        Get My Free Quote
      </button>
      <p class="mt-3 text-center text-xs text-slate-500">By submitting, you request contact about pest-control service. Availability and pricing vary by provider.</p>
    </form>
  </div>
  <script>
    // Static site (GitHub Pages): the quote form posts cross-origin to the
    // owner's lead endpoint (LEAD_ENDPOINT). It stores the lead and alerts
    // the owner; without JS the plain POST redirects back to /thank-you/.
    const form = document.getElementById("quote-form") as HTMLFormElement | null;
    const err = document.getElementById("qf-error");
    const submit = document.getElementById("qf-submit") as HTMLButtonElement | null;
    const stamp = form?.querySelector<HTMLInputElement>("[data-qf-started]");
    const source = form?.querySelector<HTMLInputElement>("[data-qf-source]");
    if (stamp) stamp.value = new Date().toISOString();
    if (source) source.value = window.location.pathname.slice(0, 200);
    if (err && new URLSearchParams(window.location.search).get("quote") === "error") {
      err.textContent = "Your request couldn't be sent. Please check your name and phone and try again.";
      err.classList.remove("hidden");
    }
    const eventId = () => {
      try { return "opp-" + crypto.randomUUID(); } catch { return "opp-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 10); }
    };
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form || !err || !submit) return;
      err.classList.add("hidden");
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const phone = String(data.get("phone") || "").trim();
      const service = String(data.get("service") || "");
      const city = String(data.get("city") || "");
      const fail = (msg: string, field?: HTMLElement | null) => {
        err.textContent = msg;
        err.classList.remove("hidden");
        form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
        if (field) {
          field.setAttribute("aria-invalid", "true");
          (field as HTMLElement).focus({ preventScroll: false });
        }
      };
      const nameEl = document.getElementById("qf-name");
      const phoneEl = document.getElementById("qf-phone");
      const serviceEl = document.getElementById("qf-service");
      const cityEl = document.getElementById("qf-city");
      if (name.length < 2) return fail("Please enter your name.", nameEl);
      if (!/^[+()\-.\s\d]{7,20}$/.test(phone)) return fail("Please enter a valid phone number.", phoneEl);
      if (!service) return fail("Please choose a service.", serviceEl);
      if (!city) return fail("Please choose your city.", cityEl);
      const attr = (window as Window & { oppAttribution?: () => { channel?: string; referrer?: string } | undefined }).oppAttribution?.();
      if (attr) {
        data.set("attr_first_medium", String(attr.channel || ""));
        data.set("attr_first_source", String(attr.referrer || ""));
      }
      if (!data.get("event_id")) data.set("event_id", eventId());
      data.set("page_title", document.title.slice(0, 200));
      submit.disabled = true;
      submit.textContent = "Sending…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new URLSearchParams(data as unknown as Record<string, string>),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          window.location.href = "/thank-you/";
        } else if (res.status === 429) {
          fail("Too many requests from this connection. Please try again in a few minutes.");
        } else {
          fail("Your request was not accepted. Please check your details and try again.");
        }
      } catch {
        fail("Couldn't reach our server. Please try again in a moment.");
      } finally {
        submit.disabled = false;
        submit.textContent = "Get My Free Quote";
      }
    });
  </script>
</section>

