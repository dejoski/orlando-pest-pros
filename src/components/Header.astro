---
import { SITE_NAME, PHONE_DISPLAY, telLink } from "../config";
import services from "../data/services.json";
import cities from "../data/cities.json";
---
<header class="sticky top-0 z-40">
  <div class="hidden bg-pine-950 text-pine-100 sm:block">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 text-xs font-medium tracking-wide sm:px-6">
      <p>Mon–Sat: 7am–7pm · Serving Osceola &amp; Orange Counties</p>
      <a href={telLink} class="inline-flex min-h-[32px] items-center gap-1.5 font-bold text-gold-300 hover:text-gold-400 hover:underline hover:underline-offset-4">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {PHONE_DISPLAY}
      </a>
    </div>
  </div>
  <div class="border-b border-pine-100 bg-cream-50/95 shadow-sm backdrop-blur">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex h-[72px] items-center justify-between gap-4">
        <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${SITE_NAME} home`}>
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M20 2l14 6v10c0 9-6 16-14 20C12 34 6 27 6 18V8l14-6z" fill="#0c3324"/>
            <path d="M14 20l4 4 8-9" stroke="#eec25c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="leading-tight">
            <span class="block font-display text-xl font-bold text-pine-950">Orlando Pest Pros</span>
            <span class="block text-[11px] font-bold uppercase tracking-[0.14em] text-ink-600">Orlando&apos;s local pest experts</span>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-[15px] font-semibold text-pine-950 lg:flex" aria-label="Primary">
          <div class="relative group">
            <button class="inline-flex min-h-[48px] items-center gap-1.5 py-2 hover:text-pine-700" aria-haspopup="true">
              Services
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            </button>
            <div class="invisible absolute left-0 top-full w-64 rounded-2xl border border-pine-100 bg-white p-2 opacity-0 shadow-xl transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              {services.services.map((s) => (
                <a href={`/services/${s.slug}/`} class="flex min-h-[48px] items-center rounded-xl px-4 py-2.5 font-medium text-ink-600 hover:bg-pine-50 hover:text-pine-900">{s.name}</a>
              ))}
            </div>
          </div>
          <div class="relative group">
            <button class="inline-flex min-h-[48px] items-center gap-1.5 py-2 hover:text-pine-700" aria-haspopup="true">
              Service Areas
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            </button>
            <div class="invisible absolute left-1/2 top-full w-[440px] -translate-x-1/2 rounded-2xl border border-pine-100 bg-white p-2 opacity-0 shadow-xl transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="grid grid-cols-2 gap-1">
                {cities.cities.map((c) => (
                  <a href={`/locations/${c.slug}/`} class="flex min-h-[48px] items-center rounded-xl px-4 py-2.5 font-medium text-ink-600 hover:bg-pine-50 hover:text-pine-900">{c.name}</a>
                ))}
              </div>
            </div>
          </div>
          <a href="/#reviews" class="inline-flex min-h-[48px] items-center hover:text-pine-700">Reviews</a>
          <a href="/#faq" class="inline-flex min-h-[48px] items-center hover:text-pine-700">FAQ</a>
        </nav>
        <div class="flex items-center gap-3">
          <a href={telLink} class="hidden min-h-[48px] items-center gap-2 rounded-full bg-gold-400 px-5 py-2.5 text-sm font-bold text-pine-950 shadow-lg shadow-gold-500/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-gold-300 sm:inline-flex">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {PHONE_DISPLAY}
          </a>
          <button id="nav-toggle" class="inline-flex min-h-[48px] min-w-[48px] items-center justify-center rounded-xl p-3 text-pine-950 hover:bg-pine-100 lg:hidden" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
    </div>
    <nav id="nav-menu" class="hidden border-t border-pine-100 bg-cream-50 px-4 py-5 lg:hidden" aria-label="Mobile">
      <p class="px-2 pb-2 text-xs font-bold uppercase tracking-[0.14em] text-ink-600">Services</p>
      <div class="grid grid-cols-1 gap-1 pb-5">
        {services.services.map((s) => (
          <a href={`/services/${s.slug}/`} class="flex min-h-[48px] items-center rounded-xl px-3 py-3 font-medium text-pine-950 hover:bg-pine-50">{s.name}</a>
        ))}
      </div>
      <p class="px-2 pb-2 text-xs font-bold uppercase tracking-[0.14em] text-ink-600">Service Areas</p>
      <div class="grid grid-cols-2 gap-1 pb-5">
        {cities.cities.map((c) => (
          <a href={`/locations/${c.slug}/`} class="flex min-h-[48px] items-center rounded-xl px-3 py-3 font-medium text-pine-950 hover:bg-pine-50">{c.name}</a>
        ))}
      </div>
      <a href={telLink} class="flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-gold-400 px-5 py-3 font-bold text-pine-950 shadow-lg shadow-gold-500/25">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Call {PHONE_DISPLAY}
      </a>
    </nav>
  </div>
</header>
