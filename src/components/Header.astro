---
import { SITE_NAME, PHONE_DISPLAY, telLink, SITE_URL } from "../config";
import services from "../data/services.json";
import cities from "../data/cities.json";
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label={`${SITE_NAME} home`}>
        <svg width="36" height="36" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 2l14 6v10c0 9-6 16-14 20C12 34 6 27 6 18V8l14-6z" fill="#166324"/>
          <path d="M14 20l4 4 8-9" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="leading-tight">
          <span class="block font-extrabold text-brand-800 text-lg">Osceola Pest Pros</span>
          <span class="block text-[11px] uppercase tracking-wide text-slate-500">Osceola & Orange Counties</span>
        </span>
      </a>
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" aria-label="Primary">
        <div class="relative group">
          <button class="flex items-center gap-1 py-2 hover:text-brand-700" aria-haspopup="true">
            Services
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition absolute left-0 top-full w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
            {services.services.map((s) => (
              <a href={`/services/${s.slug}/`} class="block rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-800">{s.name}</a>
            ))}
          </div>
        </div>
        <div class="relative group">
          <button class="flex items-center gap-1 py-2 hover:text-brand-700" aria-haspopup="true">
            Service Areas
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition absolute left-0 top-full w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
            {cities.cities.map((c) => (
              <a href={`/locations/${c.slug}/`} class="block rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-800">{c.name}</a>
            ))}
          </div>
        </div>
        <a href="/#reviews" class="hover:text-brand-700">Reviews</a>
        <a href="/#faq" class="hover:text-brand-700">FAQ</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href={telLink} class="hidden sm:inline-flex items-center gap-2 rounded-full bg-brand-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-800 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.6 2.9.7a2 2 0 011.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {PHONE_DISPLAY}
        </a>
        <button id="nav-toggle" class="lg:hidden rounded-lg p-2 hover:bg-slate-100" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
  </div>
  <nav id="nav-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-4" aria-label="Mobile">
    <p class="px-2 pb-1 text-xs font-bold uppercase tracking-wide text-slate-500">Services</p>
    <div class="grid grid-cols-1 gap-1 pb-3">
      {services.services.map((s) => (
        <a href={`/services/${s.slug}/`} class="rounded-lg px-2 py-2 font-medium hover:bg-brand-50">{s.name}</a>
      ))}
    </div>
    <p class="px-2 pb-1 text-xs font-bold uppercase tracking-wide text-slate-500">Service Areas</p>
    <div class="grid grid-cols-2 gap-1 pb-3">
      {cities.cities.map((c) => (
        <a href={`/locations/${c.slug}/`} class="rounded-lg px-2 py-2 font-medium hover:bg-brand-50">{c.name}</a>
      ))}
    </div>
    <a href={telLink} class="flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 font-bold text-white">
      Call {PHONE_DISPLAY}
    </a>
  </nav>
</header>
