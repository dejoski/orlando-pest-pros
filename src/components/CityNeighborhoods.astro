---
interface Props {
  c: any;
  bordered: boolean;
}
const { c, bordered } = Astro.props;
---
<section aria-labelledby="neighborhoods-heading" class={bordered ? "border-y border-slate-200 bg-cream-50 py-20 lg:py-24" : "bg-cream-50 py-20 lg:py-24"}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-pine-700">Neighborhoods</p>
      <h2 id="neighborhoods-heading" class="mt-3 font-display text-3xl tracking-tight text-ink-900 sm:text-4xl">Areas we serve in {c.name}</h2>
    </div>
    <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {c.areasServed.map((a: string) => (
        <li class="flex min-h-[48px] items-center gap-3 border-b border-slate-200 px-1 py-4 text-[15px] font-semibold text-ink-900">
          <span class="h-1.5 w-1.5 shrink-0 bg-gold-500" aria-hidden="true"></span>
          {a}
        </li>
      ))}
    </ul>
  </div>
</section>
