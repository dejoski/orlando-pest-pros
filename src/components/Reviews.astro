---
interface Review { name: string; city: string; rating: number; date: string; service: string; text: string }
interface Props {
  reviews: Review[];
  aggregate: { value: string; count: string };
  heading?: string;
  id?: string;
}
const { reviews, aggregate, heading = "What Your Neighbors Say", id = "reviews" } = Astro.props;

function stars(n: number) { return "★".repeat(n) + "☆".repeat(5 - n); }
function fmtDate(iso: string) {
  const d = new Date(iso + "T12:00:00");
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---
<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-heading`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 id={`${id}-heading`} class="text-2xl sm:text-3xl font-extrabold text-slate-900">{heading}</h2>
      <p class="mt-2 flex items-center gap-2 text-slate-600">
        <span class="text-accent-500 text-lg" aria-hidden="true">{stars(5)}</span>
        <span><strong>{aggregate.value}</strong> average from <strong>{aggregate.count}</strong> local reviews</span>
      </p>
    </div>
  </div>
  <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {reviews.slice(0, 9).map((r) => (
      <figure class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="text-accent-500" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
        <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">“{r.text}”</blockquote>
        <figcaption class="mt-4 border-t border-slate-100 pt-3 text-sm">
          <span class="font-bold text-slate-900">{r.name}</span>
          <span class="text-slate-500"> · {r.city}</span>
          <span class="block text-xs text-slate-400">{r.service} · {fmtDate(r.date)}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
