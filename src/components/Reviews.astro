---
interface Review { name: string; city: string; rating: number; date: string; service: string; text: string }
interface Props {
  reviews: Review[];
  aggregate: { value: string; count: string };
  heading?: string;
  id?: string;
}
const { reviews, aggregate, heading = "What Your Neighbors Say", id = "reviews" } = Astro.props;

function stars(n: number) { return "★".repeat(n) + "☆".repeat(5 - n); }
function fmtDate(iso: string) {
  const d = new Date(iso + "T12:00:00");
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---
<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-heading`}>
  <div class="max-w-3xl">
    <p class="eyebrow text-pine-700">Customer stories</p>
    <h2 id={`${id}-heading`} class="mt-3 font-display text-3xl font-bold text-pine-950 text-balance sm:text-4xl">{heading}</h2>
    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-ink-600">
      <span class="text-xl tracking-wide text-gold-600" aria-hidden="true">{stars(5)}</span>
      <span><strong class="font-bold text-pine-950">{aggregate.value}</strong> average from <strong class="font-bold text-pine-950">{aggregate.count}</strong> local reviews</span>
    </p>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-gold-500/40 bg-cream-100 px-4 py-2 text-xs font-semibold text-ink-600">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 11v5M12 8v.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Sample reviews shown for illustration — real customer reviews coming soon.
    </p>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {reviews.slice(0, 9).map((r) => (
      <figure class="flex flex-col rounded-3xl border border-pine-100 bg-white p-6 shadow-sm">
        <span aria-hidden="true" class="font-display text-5xl leading-none text-gold-400">“</span>
        <div class="mt-1 tracking-wide text-gold-600" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
        <blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-ink-600">“{r.text}”</blockquote>
        <figcaption class="mt-5 border-t border-slate-100 pt-4 text-sm">
          <span class="font-bold text-pine-950">{r.name}</span>
          <span class="text-slate-500"> · {r.city}</span>
          <span class="mt-1 block text-xs text-slate-500">{r.service} · {fmtDate(r.date)}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
