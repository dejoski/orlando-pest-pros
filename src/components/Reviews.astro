---
interface Review { name: string; city: string; rating: number; date: string; service: string; text: string }
interface Props {
  reviews?: Review[];
  aggregate?: { value: string; count: string };
  heading?: string;
  id?: string;
}
const { heading = "Before You Choose a Provider", id = "reviews" } = Astro.props;
const questions = [
  { title: "Verify the provider", text: "Confirm the company name, relevant Florida licensing, insurance and whether it covers your city. Orlando Pest Pros does not perform treatments." },
  { title: "Compare written quotes", text: "Ask what the inspection and treatment include, how follow-up works and whether recurring visits or cancellation carry additional charges." },
  { title: "Check independent reviews", text: "Read recent reviews of the provider you are considering. This website does not publish verified customer reviews or a customer rating." },
];
---
<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-heading`}>
  <div class="max-w-3xl">
    <p class="eyebrow text-pine-700">A useful provider checklist</p>
    <h2 id={`${id}-heading`} class="mt-3 font-display text-3xl font-bold text-pine-950 text-balance sm:text-4xl">{heading}</h2>
    <p class="mt-4 text-ink-600">A quote request starts a conversation. Confirm these details directly before agreeing to service.</p>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {questions.map((q) => (
      <article class="rounded-3xl border border-pine-100 bg-white p-6 shadow-sm">
        <h3 class="font-display text-xl font-bold text-pine-950">{q.title}</h3>
        <p class="mt-3 leading-relaxed text-ink-600">{q.text}</p>
      </article>
    ))}
  </div>
</section>
