---
interface StatItem {
  value: string;
  label: string;
}
interface Props {
  stats: StatItem[];
  note?: string;
}
const { stats, note = "Illustrative figures — real numbers coming soon." } = Astro.props;
---
<section class="overflow-hidden rounded-[2rem] border-t-4 border-gold-400 bg-pine-950 px-6 py-12 sm:p-12" aria-label="Company highlights">
  <dl class="grid grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4">
    {stats.map((s) => (
      <div class="flex flex-col items-center text-center">
        <dt class="order-2 mt-3 max-w-[220px] text-sm font-medium leading-snug text-pine-100">{s.label}</dt>
        <dd class="order-1 font-display text-4xl font-bold text-gold-400 sm:text-5xl">{s.value}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-10 text-center text-xs italic text-pine-200/70">{note}</p>
</section>
