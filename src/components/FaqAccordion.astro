---
interface Faq { q: string; a: string }
interface Props { faqs: Faq[]; heading?: string; id?: string }
const { faqs, heading = "Frequently Asked Questions", id = "faq" } = Astro.props;
---
<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="text-2xl sm:text-3xl font-extrabold text-slate-900">{heading}</h2>
  <div class="mt-6 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    {faqs.map((f, i) => (
      <div class="faq-item" data-open={i === 0 ? "true" : "false"}>
        <h3>
          <button type="button" aria-expanded={i === 0 ? "true" : "false"}
            class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-slate-900 hover:text-brand-700">
            <span>{f.q}</span>
            <svg class="faq-chevron shrink-0" width="18" height="18" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
            </svg>
          </button>
        </h3>
        <div class="faq-answer"><div><p class="px-5 pb-5 text-slate-600 leading-relaxed">{f.a}</p></div></div>
      </div>
    ))}
  </div>
</section>
