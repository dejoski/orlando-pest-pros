---
interface Faq { q: string; a: string }
interface Props { faqs: Faq[]; heading?: string; id?: string }
const { faqs, heading = "Frequently Asked Questions", id = "faq" } = Astro.props;
---
<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="font-display text-3xl font-bold text-pine-950 text-balance sm:text-4xl">{heading}</h2>
  <div class="mt-8 divide-y divide-pine-100 overflow-hidden rounded-3xl border border-pine-100 bg-white shadow-sm">
    {faqs.map((f, i) => (
      <div class="faq-item" data-open={i === 0 ? "true" : "false"}>
        <h3>
          <button type="button" aria-expanded={i === 0 ? "true" : "false"}
            class="flex min-h-[64px] w-full items-center justify-between gap-4 px-6 py-5 text-left hover:bg-pine-50/60">
            <span class="font-semibold text-pine-950">{f.q}</span>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-pine-50 text-pine-800">
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </h3>
        <div class="faq-answer"><div><p class="px-6 pb-6 leading-relaxed text-ink-600">{f.a}</p></div></div>
      </div>
    ))}
  </div>
</section>
