---
import type { Crumb } from "../lib/schema";
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-slate-300">/</span>}
        {i < crumbs.length - 1
          ? <a href={c.url} class="hover:text-brand-700 hover:underline">{c.name}</a>
          : <span aria-current="page" class="font-medium text-slate-700">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
