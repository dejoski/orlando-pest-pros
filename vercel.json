{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "osceola-pest-pros.vercel.app" }],
      "destination": "https://orlandopestcontrol.top/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "orlando-pest-pros.vercel.app" }],
      "destination": "https://orlandopestcontrol.top/:path*",
      "permanent": true
    }
  ]
}
